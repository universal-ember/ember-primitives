{
  "name": "test-playwright",
  "version": "0.0.0",
  "private": true,
  "description": "Real key presses in a real browser, for behavior that test-app cannot start",
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:prettier": "prettier --check .",
    "lint:types": "ember-tsc --noEmit",
    "start": "vite",
    "sync": "echo 'pnpm is syncing injected deps. (this is configured in .npmrc)'",
    "test:playwright": "playwright test"
  },
  "dependencies": {
    "ember-primitives": "workspace:^"
  },
  "dependenciesMeta": {
    "ember-primitives": {
      "injected": true
    }
  },
  "devDependencies": {
    "@babel/core": "^8.0.0",
    "@babel/plugin-transform-runtime": "^8.0.0",
    "@babel/plugin-transform-typescript": "^8.0.0",
    "@babel/runtime": "^8.0.0",
    "@ember/app-tsconfig": "^2.0.0",
    "@embroider/core": "^4.4.3",
    "@embroider/macros": "^1.19.7",
    "@embroider/vite": "^1.5.2",
    "@glimmer/component": "^2.0.0",
    "@glint/ember-tsc": "^1.1.1",
    "@glint/template": "1.7.7",
    "@nullvoxpopuli/eslint-configs": "^7.0.0",
    "@playwright/test": "^1.57.0",
    "@rollup/plugin-babel": "^7.0.0",
    "babel-plugin-ember-template-compilation": "^4.0.0",
    "decorator-transforms": "2.3.1",
    "ember-source": "^7.1.0",
    "eslint": "^10.0.0",
    "prettier": "^3.8.1",
    "prettier-plugin-ember-template-tag": "^2.1.3",
    "typescript": "^7.0.0",
    "vite": "^8.0.3"
  },
  "engines": {
    "node": ">= 20"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "type": "app",
    "version": 2
  },
  "imports": {
    "#tests/*": "./tests/*"
  },
  "exports": {
    "./*": "./app/*"
  }
}
